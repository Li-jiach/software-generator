DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=copyright_workspace
DB_USERNAME=root
DB_PASSWORD=
# 若 PATH 中的 Java 不是 JDK 17，填写本机 JDK 17 安装目录。
JAVA_HOME=
# 设置随机值，Java与Python必须一致。
SERVICE_TOKEN=
# 首次启动创建admin、adminDept、research账号；至少12位，数据库只保存BCrypt哈希。
BOOTSTRAP_PASSWORD=
# 本机 HTTP 使用 false；通过 HTTPS 部署时设为 true。
SECURE_COOKIE=false
# 可选；未填写时使用 Google Chrome 的默认安装位置。
# MANUAL_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 官网账号的 AES-256 加密密钥。用 openssl rand -base64 32 生成并妥善备份。
OFFICIAL_CREDENTIAL_KEY=
# 可选；PATH 找不到 LibreOffice 时指定 soffice 可执行文件。
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# 可选；自定义附件目录请使用绝对路径，并确保 Java 服务可读写。
# ATTACHMENT_DIR=/absolute/path/to/attachments
