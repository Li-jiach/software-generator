{
  "extensions": [".html", ".htm", ".vue", ".svelte", ".astro", ".jsx", ".tsx", ".js", ".mjs", ".cjs", ".ts", ".css", ".scss", ".less", ".md", ".java", ".kt", ".py", ".go", ".rs", ".rb", ".php", ".cs", ".sql", ".jsp", ".razor", ".cshtml", ".twig"],
  "manifests": ["package.json", "pom.xml", "build.gradle", "build.gradle.kts", "pyproject.toml", "requirements.txt", "go.mod", "cargo.toml", "composer.json", "gemfile"],
